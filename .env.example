# Vorlage. install.sh erzeugt daraus eine echte .env mit zufälligen Werten.
# Lokal genügt es, diese Datei nach .env zu kopieren.

# Port des Servers
PORT=3000

# Adresse, an die der Server bindet. Standard: nur lokal erreichbar — cloudflared
# spricht ihn ohnehin über localhost an (siehe deploy/install.sh). Nur ändern,
# wer den Port bewusst im Netz freigeben will UND weiss, dass "trust proxy" in
# app.js dann jeder eingehenden Verbindung ihre X-Forwarded-For-Kopfzeile glaubt —
# ohne einen echten vorgeschalteten Proxy liesse sich die Login-Bremse damit umgehen.
# SB_HOST=0.0.0.0

# Datei, in der alles gespeichert wird
SB_DB=data/schichtplan.db

# Unterschreibt das Sitzungs-Cookie. Muss geheim und zufällig sein.
# Neu erzeugen mit:  openssl rand -hex 32
SB_SESSION_SECRET=bitte-aendern

# Zugang zur Unternehmensverwaltung (der Bildschirm über allen Firmen).
# Diese Werte sind nur fürs Ausprobieren gedacht — install.sh erzeugt für den
# Server ein zufälliges Passwort.
SB_SUPER_CODE=000000
SB_SUPER_NAME=Kira X
SB_SUPER_PASSWORD=123456

# 1 = Demo-Firma anlegen, wenn die Datenbank leer ist
# (Firmencode 111111, Mara Vogt / Lea Brunner, Passwort 12345)
SB_SEED_DEMO=1

# 1 = Cookie nur über HTTPS senden. Hinter cloudflared immer 1.
SB_SECURE_COOKIE=0

# SMTP-Zugang für Benachrichtigungen (neue Anmeldung wartet, neue Zuteilung
# mit Kalenderdatei). Ohne SB_SMTP_HOST verschickt der Server keine Mails —
# alles andere funktioniert trotzdem, es fehlt dann nur die Benachrichtigung.
# SB_SMTP_HOST=smtp.example.com
# SB_SMTP_PORT=587
# SB_SMTP_SECURE=0
# SB_SMTP_USER=
# SB_SMTP_PASSWORD=
# SB_MAIL_FROM=schichtboard@example.com
